# Local development environment variables (loaded automatically by Vite)

# Clerk publishable key (REQUIRED to start the app).
# Get yours at https://dashboard.clerk.com  ->  API Keys  ->  Publishable key
# It starts with pk_test_ for development instances.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY

# Not needed for `npm run dev` — api.js uses /api in dev, proxied to
# http://localhost:8080 by vite.config.js. Only used for production builds.
# VITE_API_BASE_URL=
